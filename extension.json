{
  "schema": 1,
  "name": "gemma4",
  "version": "0.1.0",
  "api_version": ">= 0.2.9",
  "entry": "gemma4_register",
  "registration_target": "gufo_gemma4",
  "depends": [],
  "platforms": ["linux"],
  "providers": [
    {
      "id": "gemma4",
      "capability": "text_generation",
      "keys": ["gguf:gemma4"],
      "model_ids": [
        "gemma-4-31B-it",
        "gemma-4-31B-it-qat",
        "gemma-4-26B-A4B-it"
      ],
      "speculative": ["mtp"],
      "target": "gufo_gemma4_text",
      "entry": "gemma4_provider_register",
      "serving": {"draft_options": {"mtp": "--mtp-model"}}
    }
  ],
  "options": [
    {
      "name": "--mtp-model",
      "type": "path",
      "commands": ["serve", "bench", "prompt"],
      "providers": ["gemma4"],
      "help": "gemma4-assistant MTP drafter GGUF for --speculative mtp"
    },
    {
      "name": "--draft-calibration",
      "type": "string",
      "commands": ["serve", "bench", "prompt", "chat"],
      "providers": ["gemma4"],
      "help": "Where the calibrated policy learns: shared or request (exact seeded replay; default: shared)"
    },
    {
      "name": "--draft-trace",
      "type": "path",
      "commands": ["serve", "bench", "prompt", "chat"],
      "providers": ["gemma4"],
      "help": "Append one JSON line per MTP verification cycle to this file"
    },
    {
      "name": "--prefill-weights",
      "type": "string",
      "commands": ["serve", "bench", "prompt", "chat"],
      "providers": ["gemma4"],
      "help": "Prefill copies of the projections: off, compact or decoded (default: off)"
    },
    {
      "name": "--image-tokens",
      "type": "integer",
      "commands": ["serve", "prompt", "chat"],
      "providers": ["gemma4"],
      "help": "Soft tokens per image: 70, 140, 280, 560 or 1120 (default: 280)"
    }
  ],
  "targets": {
    "gufo_gemma4":                    {"requires": []},
    "gufo_gemma4_hip":                {"requires": ["hip"]},
    "gufo_gemma4_text":               {"requires": ["hip"]},
    "gufo_gemma4_reference":          {"requires": ["testing"]},
    "gemma4_config_test":             {"requires": ["testing"], "role": "test"},
    "gemma4_cycle_trace_test":        {"requires": ["testing"], "role": "test"},
    "gemma4_draft_policy_test":       {"requires": ["testing"], "role": "test"},
    "gemma4_draft_vocab_test":        {"requires": ["testing"], "role": "test"},
    "gemma4_tokenizer_contract_test": {"requires": ["testing"], "role": "test"},
    "gemma4_template_test":           {"requires": ["testing"], "role": "test"},
    "gemma4_tool_syntax_test":        {"requires": ["testing"], "role": "test"},
    "gemma4_vision_prompt_test":      {"requires": ["testing"], "role": "test"},
    "gemma4_text_contract_test":      {"requires": ["testing"], "role": "test"},
    "gemma4_artifact_test":           {"requires": ["testing"], "role": "test"},
    "gemma4_attention_ops_test":      {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_kernel_ops_test":         {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_moe_ops_test":            {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_projection_ops_test":     {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_target_test":             {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_continuation_test":       {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_vision_encoder_test":     {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_vision_session_test":     {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_draft_replay":            {"requires": ["testing"], "role": "test"},
    "gemma4_reference_probe":         {"requires": ["testing"], "role": "test"},
    "gemma4_vision_probe":            {"requires": ["testing"], "role": "test"},
    "gemma4_vision_generate_probe":   {"requires": ["hip", "testing"], "role": "test"},
    "gemma4_gpu_probe":               {"requires": ["hip", "testing"], "role": "test"}
  },
  "licenses": ["LICENSE", "LICENSES/gufo.txt"]
}
